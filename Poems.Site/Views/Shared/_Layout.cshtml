<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Найдите любимое стихотворение по автору, названию или одной запомнившейся строке." />
    <title>@ViewData["Title"] — PoemsSite</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <header class="site-header page-width">
        <div class="theme-control">
            <label for="themeSelect">Тема</label>
            <select id="themeSelect" name="theme">
                <option value="system" selected>Системная</option>
                <option value="light">Белая</option>
                <option value="dark">Тёмная</option>
            </select>
        </div>
    </header>
    <main id="main" class="page-width" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer page-width">
        <a href="https://github.com/V0R0N01D/PoemsSite">Проект на GitHub <span aria-hidden="true">↗</span></a>
    </footer>
    <div id="notifications" class="notifications" aria-live="polite" aria-label="Уведомления"></div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
