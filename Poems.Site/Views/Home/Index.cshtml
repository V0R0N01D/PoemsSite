@{
    ViewData["Title"] = "Поиск русской поэзии";
}

<section class="search-page" aria-labelledby="pageTitle" data-elasticsearch-enabled="@Json.Serialize(Model.ElasticsearchEnabled)"
         data-vector-search-enabled="@Json.Serialize(Model.VectorSearchEnabled)">
    <div class="intro">
        <h1 id="pageTitle">Поиск русской поэзии</h1>
    </div>

    <section class="search-card" aria-label="Поиск по библиотеке">
        <div class="search-toolbar">
            <div id="searchTabs" class="search-engines" role="group" aria-label="Способ поиска">
                <button id="db-tab" class="engine-button" data-search-type="db" type="button" aria-pressed="true">PostgreSQL</button>
                <span id="elastic-tab-container" hidden>
                    <button id="elastic-tab" class="engine-button" data-search-type="elastic" type="button" aria-pressed="false">Elasticsearch</button>
                </span>
                <span id="vector-tab-container" hidden>
                    <button id="vector-tab" class="engine-button" data-search-type="vector" type="button" aria-pressed="false">По смыслу</button>
                </span>
            </div>
            <span class="search-timing">Время поиска: <span id="queryTime">—</span></span>
        </div>

        <div class="search-control">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
            <input type="search" id="searchBox" class="search-input" placeholder="Автор, название или строка…"
                   autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-label="Поиск русской поэзии"
                   aria-expanded="false" aria-controls="searchResults" aria-describedby="searchHint" />
            <span id="loadingIndicator" class="loading-indicator" aria-hidden="true" hidden></span>
            <div id="suggestions" class="suggestions" hidden>
                <div class="suggestions-heading"><span id="resultCount">Результаты поиска</span><span aria-hidden="true">↑ ↓ для выбора</span></div>
                <ul id="searchResults" class="suggestions-list" role="listbox" aria-label="Найденные произведения"></ul>
                <p id="suggestionsState" class="suggestions-state" hidden></p>
            </div>
        </div>
        <p id="searchHint" class="search-hint">
            <span id="textSearchHint">Поиск по автору, названию и тексту. Например: <button class="example-query" type="button" data-query="Пушкин">Пушкин</button> или <button class="example-query" type="button" data-query="Я помню чудное мгновенье">Я помню чудное мгновенье</button>.</span>
            <span id="vectorSearchHint" hidden>Опишите тему или настроение. Например: <button class="example-query" type="button" data-query="одиночество и надежда">одиночество и надежда</button>. От 3 до 1000 символов, до 256 токенов.</span>
        </p>
        <p id="searchStatus" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></p>
    </section>

    <div id="readingPlaceholder" class="reading-placeholder">
        <span class="ornament" aria-hidden="true">❧</span>
        <p>Вспомните одну строку.<br /><span>Остальное найдётся.</span></p>
    </div>

    <article id="poemContainer" class="poem-card" aria-labelledby="poemTitle" hidden>
        <div class="poem-heading">
            <p class="eyebrow">Наедине со стихотворением</p>
            <h2 id="poemTitle" tabindex="-1"></h2>
            <p id="poemAuthor" class="poem-author"></p>
        </div>
        <div id="poemContent" class="poem-content"></div>
        <a class="back-to-search" href="#searchBox">↑ Вернуться к поиску</a>
    </article>
</section>

<button id="scrollTopButton" class="scroll-top-button" type="button"
        aria-label="Вернуться наверх к поиску" title="Вернуться наверх к поиску" hidden>
    <span aria-hidden="true">↑</span><span class="scroll-top-label">Наверх</span>
</button>

@section Scripts {
    <script type="module" src="~/js/search.js" asp-append-version="true"></script>
}
